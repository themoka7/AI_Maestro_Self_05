# NAVER API HUB (네이버 클라우드 플랫폼)
#   콘솔    https://console.ncloud.com  →  Services  →  NAVER API HUB
#   인증키  마이페이지 → 인증키 관리
#
# 검색 API 는 2026년 개발자센터(developers.naver.com)에서 NAVER API HUB 로 이관되었습니다.
# 구 개발자센터의 X-Naver-Client-Id / X-Naver-Client-Secret 키는 더 이상 쓰이지 않습니다.
# API HUB 는 NCP 종량 과금이므로 쿼리 수와 실행 주기가 곧 비용입니다.
NCP_API_KEY_ID=
NCP_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 분류 모델 (기본값: claude-sonnet-5)
CLASSIFIER_MODEL=claude-sonnet-5
